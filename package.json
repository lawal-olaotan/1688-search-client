{
  "name": "payment",
  "version": "2.5.0",
  "description": "Payment API",
  "main": "app.ts",
  "author": "robotdorm",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:dev": "bun build ./app.ts --outdir ./build --splitting --target node --hot",
    "build": "bun build ./app.ts --outdir=./build --splitting --target node --watch",
    "start": "node build/app.js",
    "run:node": "ts-node app.ts",
    "node:dev": "nodemon --watch \"./*\" --ext \"ts,json\" --ignore \"src/**/*.spec.ts\" --exec \"bun run run:node\""
  },
  "dependencies": {
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16",
    "express": "^4.18.1",
    "mongodb": "^6.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "serverless": "^3.38.0",
    "stripe": "^14.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.30",
    "bun-types": "latest",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.2",
    "tsx": "4.7.2",
    "typescript": "^5.4.5"
  }
}
