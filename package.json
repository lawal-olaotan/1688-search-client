{
  "name": "payment",
  "version": "1.0.0",
  "description": "Payment API",
  "main": "app.ts",
  "author": "Zikama",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:dev": "bun build ./app.ts --outdir ./build --splitting --target node --hot",
    "build": "bun build ./app.ts --outdir=./build --splitting --target node --watch",
    "dev": "bun --watch --inspect app.ts",
    "run:node": "ts-node  --esm --experimental-specifier-resolution=node app.ts",
    "node:dev": "nodemon --watch \"./*\" --ext \"ts,json\" --ignore \"src/**/*.spec.ts\" --exec \"bun run run:node\""
  },
  "dependencies": {
    "express": "^4.18.1",
    "stripe": "^14.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "bun-types": "latest",
    "nodemon": "^3.0.1"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
